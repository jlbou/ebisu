# Ebisu: variables de entorno. Copiar a .env y rellenar AHI (nunca aqui: este fichero va a git).
# El .env no entra nunca en git ni se pega en el chat.

# Trading 212: por ahora SOLO la cuenta demo (dinero ficticio).
# La clave y el secreto se generan en la app: Ajustes > API (el secreto se ensenya una sola vez).
# Permisos: solo los necesarios; nunca retiradas.
T212_ENTORNO=demo
T212_API_KEY=
T212_API_SECRET=


# Telegram: el bot lo crea el propietario con @BotFather. El token va SOLO aqui (en el .env), nunca en el chat.
# El identificador del chat se saca despues (lo explica la IA cuando haga falta).
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Healthchecks.io: URL secretas (quien las tenga puede tapar una caida). CADA UNA SOLO DONDE SE LATE: las del VPS solo
# en el .env del VPS; la del portatil solo en el del portatil (si no, una maquina podria latir por la otra).
# VPS: la vuelta del dia (comprobacion ebisu-dia) y la copia del VPS (ebisu-copia).
HEALTHCHECK_EBISU=
HEALTHCHECK_EBISU_COPIA=
# Portatil: la copia que baja el portatil (ebisu-copia-portatil).
HEALTHCHECK_EBISU_COPIA_PORTATIL=

# La IA en sombra (bot en papel): token de la suscripcion, generado por el propietario con `claude setup-token`.
# El bot nunca se lo pasa a la IA como variable heredada ni lo ensenya en ningun log.
CLAUDE_CODE_OAUTH_TOKEN=
